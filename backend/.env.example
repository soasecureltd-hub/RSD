# Database URL (SQLite by default, can upgrade to PostgreSQL)
DATABASE_URL=sqlite:///./rsd.db

# FastAPI Configuration
# Keep DEBUG=False in any non-local environment (exposes stack traces otherwise).
DEBUG=True
API_TITLE=Risk-Security Diagnostic API
API_VERSION=1.0.0

# JWT Authentication
# REQUIRED in production. Generate a strong value, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# The app refuses to start when DEBUG=False and this is unset.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Camera Configuration
CAMERA_HISTORY_SIZE=100
CAMERA_FRAME_SKIP=3
YOLO_CONFIDENCE_THRESHOLD=0.5

# Rate limiting
RATE_LIMIT_CAMERA_ANALYZE=20/minute

# ML Model Path
MODEL_PATH=security_multiorg_model.pkl

# Error monitoring (optional)
SENTRY_DSN=

# CORS Origins (add your frontend URL)
ALLOWED_ORIGINS=["http://localhost:3000", "http://localhost:5173", "http://127.0.0.1:3000", "http://127.0.0.1:5173"]
